datasource db {
  provider = "sqlite"
  url      = "file:data.db"
}

generator client {
  provider = "prisma-client-js"
}

model Search {
  id        Int      @id @default(autoincrement())
  keyword   String
  city      String   @default("")
  startDate String   @default("") @map("start_date")
  endDate   String   @default("") @map("end_date")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("searches")
}
